# Copy to .env (which is gitignored) or ~/.openai-ads-mcp/.env and fill in.
# Never commit real values.

# --- Ads API key (set ONE of these, or neither if you ran `openai-ads-mcp auth`) ---

# Ads Manager (ads.openai.com) -> Settings -> General -> API keys. This is an Ads API
# key, not an OpenAI platform API key. Prefer `openai-ads-mcp auth`, which stores it
# in ~/.openai-ads-mcp/secrets/openai-ads-key.json with owner-only permissions.
OPENAI_ADS_API_KEY=
OPENAI_ADS_KEY_FILE=

# Only for partner keys that reach several ad accounts (sent as OpenAI-Ad-Account).
OPENAI_ADS_AD_ACCOUNT_ID=

# --- Optional ---

# Start in dry-run: writes are logged and previewed but NOT sent to OpenAI.
OPENAI_ADS_DRY_RUN=true

# Register only read-only tools (lists, insights, previews).
OPENAI_ADS_READ_ONLY=false

# Only register some tool groups, e.g. account,campaigns,ad_groups,ads,status,reporting
OPENAI_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
OPENAI_ADS_BULK_THRESHOLD=10
OPENAI_ADS_MAX_INCREASE_PCT=20
# Optional absolute caps in the account currency (blank = no cap).
OPENAI_ADS_MAX_DAILY_BUDGET=
OPENAI_ADS_MAX_LIFETIME_BUDGET=
OPENAI_ADS_MAX_BID=

# Folder that local images and customer lists may be uploaded from (blank = URL uploads only).
OPENAI_ADS_UPLOAD_DIR=

# Per-user data folder (default ~/.openai-ads-mcp): secrets/, logs/audit.jsonl, .env
OPENAI_ADS_HOME=
# Audit log of writes (JSONL) and how many days to keep entries (0 = forever).
OPENAI_ADS_AUDIT_LOG=
OPENAI_ADS_AUDIT_RETENTION_DAYS=30

# Results per page for list calls (1-500), and per-request timeout in seconds.
OPENAI_ADS_PAGE_SIZE=100
OPENAI_ADS_TIMEOUT=30

OPENAI_ADS_LOG_LEVEL=INFO

# Transport: stdio (Claude Code / Desktop) or streamable-http (served at /mcp).
OPENAI_ADS_TRANSPORT=stdio
OPENAI_ADS_HOST=127.0.0.1
OPENAI_ADS_PORT=8000
# HTTP transports refuse non-loopback hosts unless this is true. The server has no
# authentication of its own; only set this behind your own auth.
OPENAI_ADS_ALLOW_REMOTE=false
